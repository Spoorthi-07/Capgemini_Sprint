<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Cross Browser Suite"
       parallel="tests"
       thread-count="3">

    <!-- Chrome -->
    <test name="Chrome Test">

        <parameter name="browser" value="chrome"/>

        <classes>
		    <class name="organizationscript.OrganizationTest"/>
		    <class name="homescript.HomeTest"/>
		    <class name="contactscript.ContactTest"/>
	        <class name="calendarscript.CalendarTest"/>
        </classes>

    </test>


    <!-- Edge -->
    <test name="Edge Test">

        <parameter name="browser" value="edge"/>

       <classes>
		    <class name="organizationscript.OrganizationTest"/>
		    <class name="homescript.HomeTest"/>
		    <class name="contactscript.ContactTest"/>
	        <class name="calendarscript.CalendarTest"/>
        </classes>

    </test>


    <!-- Firefox -->
    <test name="Firefox Test">

        <parameter name="browser" value="firefox"/>

        <classes>
		    <class name="organizationscript.OrganizationTest"/>
		    <class name="homescript.HomeTest"/>
		    <class name="contactscript.ContactTest"/>
	        <class name="calendarscript.CalendarTest"/>
        </classes>

    </test> <!-- Test -->
</suite> <!-- Suite -->